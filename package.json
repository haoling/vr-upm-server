{
  "name": "vr-upm-server",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -Api -j unlimited --include @vr-upm/server --include @vr-upm/web run dev",
    "build": "yarn workspaces foreach -At run build",
    "typecheck": "yarn workspaces foreach -Ap run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "yarn workspace @vr-upm/fixtures generate"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  }
}
