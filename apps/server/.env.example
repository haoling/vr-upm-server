# 起動モード: all(API + Worker)/ api / worker
MODE=all
PORT=3000
# SQLite の置き場所(k8s では db PVC)
DB_PATH=./data/db/app.sqlite
# 元 unitypackage・ビルド作業領域(k8s では workspace PVC)
WORKSPACE_DIR=./data/workspace
# CSRF 対策で許可する Origin(管理画面の外部 URL)。カンマ区切りで複数可
ALLOWED_ORIGINS=http://localhost:5173
# ビルド済み SPA の場所(未指定なら配信しない)
# WEB_DIST_DIR=../web/dist
